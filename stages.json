        {
          "name": "items",
          "type": "list",
          "optional": false,
          "description": "Items to extend the list with"
        }
      ],
      "outputs": [
        {
          "name": "list",
          "type": "list",
          "optional": false,
          "description": "Resulting list after extend"
        }
      ]
    },
    "FilterListStage": {
      "stage_name": "FilterListStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.lists",
      "icon": "▽",
      "icon_mono": false,
      "color": null,
      "description": "Filter list items by CEL condition; current element is bound as `item`",
      "arguments": [
        {
          "name": "items",
          "type": "list",
          "optional": false,
          "description": "List to filter"
        },
        {
          "name": "condition",
          "type": "string",
          "optional": false,
          "description": "CEL condition evaluated per element, e.g. 'item > 2'"
        },
        {
          "name": "*",
          "type": "any",
          "optional": false,
          "description": "Any other argument is visible to the condition as vars.<name>"
        }
      ],
      "outputs": [
        {
          "name": "list",
          "type": "list",
          "optional": false,
          "description": "Filtered list"
        }
      ]
    },
    "UniqueListStage": {
      "stage_name": "UniqueListStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.lists",
      "icon": "≠",
      "icon_mono": false,
      "color": null,
      "description": "Deduplicate list while preserving original order",
      "arguments": [
        {
          "name": "items",
          "type": "list",
          "optional": false,
          "description": "List to deduplicate"
        }
      ],
      "outputs": [
        {
          "name": "list",
          "type": "list",
          "optional": false,
          "description": "List with unique items"
        }
      ]
    },
    "PopListStage": {
      "stage_name": "PopListStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.lists",
      "icon": "⊟",
      "icon_mono": false,
      "color": null,
      "description": "Pop element from list (default last) and return list+popped value",
      "arguments": [
        {
          "name": "items",
          "type": "list",
          "optional": false,
          "description": "List to pop from"
        },
        {
          "name": "index",
          "type": "int",
          "optional": true,
          "description": "Index to pop, -1 means last element",
          "default": -1
        }
      ],
      "outputs": [
        {
          "name": "list",
          "type": "list",
          "optional": false,
          "description": "List after pop"
        },
        {
          "name": "popped",
          "type": "any",
          "optional": false,
          "description": "Popped value"
        }
      ]
    },
    "AssertStage": {
      "stage_name": "AssertStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
