      "icon_mono": false,
      "color": null,
      "description": "Pick only specified keys from a dict and return new object",
      "arguments": [
        {
          "name": "src",
          "type": "object",
          "optional": false,
          "description": "Source dict"
        },
        {
          "name": "keys",
          "type": "list",
          "optional": false,
          "description": "Keys to keep in the result"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": "object",
          "optional": false,
          "description": "Dict containing only picked keys"
        }
      ]
    },
    "DropKeysStage": {
      "stage_name": "DropKeysStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.dicts",
      "icon": "⊘",
      "icon_mono": false,
      "color": null,
      "description": "Remove specified keys from dict and return cleaned object",
      "arguments": [
        {
          "name": "src",
          "type": "object",
          "optional": false,
          "description": "Source dict"
        },
        {
          "name": "keys",
          "type": "list",
          "optional": false,
          "description": "Keys to remove from the dict"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": "object",
          "optional": false,
          "description": "Dict without removed keys"
        }
      ]
    },
    "AppendListStage": {
      "stage_name": "AppendListStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
