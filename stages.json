      "icon": "⊕",
      "icon_mono": false,
      "color": null,
      "description": "Append value to list (creates list if missing)",
      "arguments": [
        {
          "name": "list",
          "type": "list",
          "optional": true,
          "description": "List to append to (empty list if missing)",
          "default": []
        },
        {
          "name": "value",
          "type": "any",
          "optional": false,
          "description": "Value to append"
        }
      ],
      "outputs": [
        {
          "name": "list",
          "type": "list",
          "optional": false,
          "description": "Resulting list after append"
        }
      ]
    },
    "ExtendListStage": {
      "stage_name": "ExtendListStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.lists",
      "icon": "⊞",
      "icon_mono": false,
      "color": null,
      "description": "Extend list with items from arguments",
      "arguments": [
        {
          "name": "list",
          "type": "list",
          "optional": true,
          "description": "Base list to extend (empty list if missing)",
          "default": []
