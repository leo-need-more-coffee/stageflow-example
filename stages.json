{
  "stages": {
    "PickKeysStage": {
      "stage_name": "PickKeysStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.dicts",
      "icon": "⊂",
      "icon_mono": false,
      "color": null,
      "description": "Pick only specified keys from a dict and return new object",
      "arguments": [
        {
          "name": "src",
          "type": "object",
          "optional": false,
          "description": "Source dict"
        },
        {
          "name": "keys",
          "type": "list",
          "optional": false,
          "description": "Keys to keep in the result"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": "object",
          "optional": false,
          "description": "Dict containing only picked keys"
        }
      ]
    },
    "DropKeysStage": {
      "stage_name": "DropKeysStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.dicts",
      "icon": "⊘",
      "icon_mono": false,
      "color": null,
      "description": "Remove specified keys from dict and return cleaned object",
      "arguments": [
        {
          "name": "src",
          "type": "object",
          "optional": false,
          "description": "Source dict"
        },
        {
          "name": "keys",
          "type": "list",
          "optional": false,
          "description": "Keys to remove from the dict"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": "object",
          "optional": false,
          "description": "Dict without removed keys"
        }
      ]
    },
    "AppendListStage": {
      "stage_name": "AppendListStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.lists",
      "icon": "⊕",
      "icon_mono": false,
      "color": null,
      "description": "Append value to list (creates list if missing)",
      "arguments": [
        {
          "name": "list",
          "type": "list",
          "optional": true,
          "description": "List to append to (empty list if missing)",
          "default": []
        },
        {
          "name": "value",
          "type": "any",
          "optional": false,
          "description": "Value to append"
        }
      ],
      "outputs": [
        {
          "name": "list",
          "type": "list",
          "optional": false,
          "description": "Resulting list after append"
        }
      ]
    },
    "ExtendListStage": {
      "stage_name": "ExtendListStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.lists",
      "icon": "⊞",
      "icon_mono": false,
      "color": null,
      "description": "Extend list with items from arguments",
      "arguments": [
        {
          "name": "list",
          "type": "list",
          "optional": true,
          "description": "Base list to extend (empty list if missing)",
          "default": []
        },
        {
          "name": "items",
          "type": "list",
          "optional": false,
          "description": "Items to extend the list with"
        }
      ],
      "outputs": [
        {
          "name": "list",
          "type": "list",
          "optional": false,
          "description": "Resulting list after extend"
        }
      ]
    },
    "FilterListStage": {
      "stage_name": "FilterListStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.lists",
      "icon": "▽",
      "icon_mono": false,
      "color": null,
      "description": "Filter list items by CEL condition; current element is bound as `item`",
      "arguments": [
        {
          "name": "items",
          "type": "list",
          "optional": false,
          "description": "List to filter"
        },
        {
          "name": "condition",
          "type": "string",
          "optional": false,
          "description": "CEL condition evaluated per element, e.g. 'item > 2'"
        },
        {
          "name": "*",
          "type": "any",
          "optional": false,
          "description": "Any other argument is visible to the condition as vars.<name>"
        }
      ],
      "outputs": [
        {
          "name": "list",
          "type": "list",
          "optional": false,
          "description": "Filtered list"
        }
      ]
    },
    "UniqueListStage": {
      "stage_name": "UniqueListStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.lists",
      "icon": "≠",
      "icon_mono": false,
      "color": null,
      "description": "Deduplicate list while preserving original order",
      "arguments": [
        {
          "name": "items",
          "type": "list",
          "optional": false,
          "description": "List to deduplicate"
        }
      ],
      "outputs": [
        {
          "name": "list",
          "type": "list",
          "optional": false,
          "description": "List with unique items"
        }
      ]
    },
    "PopListStage": {
      "stage_name": "PopListStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.lists",
      "icon": "⊟",
      "icon_mono": false,
      "color": null,
      "description": "Pop element from list (default last) and return list+popped value",
      "arguments": [
        {
          "name": "items",
          "type": "list",
          "optional": false,
          "description": "List to pop from"
        },
        {
          "name": "index",
          "type": "int",
          "optional": true,
          "description": "Index to pop, -1 means last element",
          "default": -1
        }
      ],
      "outputs": [
        {
          "name": "list",
          "type": "list",
          "optional": false,
          "description": "List after pop"
        },
        {
          "name": "popped",
          "type": "any",
          "optional": false,
          "description": "Popped value"
        }
      ]
    },
    "AssertStage": {
      "stage_name": "AssertStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.logic",
      "icon": "✓",
      "icon_mono": false,
      "color": null,
      "description": "Validate CEL condition against stage arguments, raise on failure",
      "arguments": [
        {
          "name": "condition",
          "type": "string",
          "optional": false,
          "description": "CEL condition; other arguments of the stage are visible as vars.*"
        },
        {
          "name": "message",
          "type": "string",
          "optional": true,
          "description": "Error message when condition fails",
          "default": "assertion failed"
        },
        {
          "name": "*",
          "type": "any",
          "optional": false,
          "description": "Any other argument is visible to the condition as vars.<name>"
        }
      ],
      "outputs": []
    },
    "FailStage": {
      "stage_name": "FailStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.logic",
      "icon": "✕",
      "icon_mono": false,
      "color": null,
      "description": "Always raise a runtime error with provided message",
      "arguments": [
        {
          "name": "message",
          "type": "string",
          "optional": true,
          "description": "Message for raised error",
          "default": "fail"
        }
      ],
      "outputs": []
    },
    "LogStage": {
      "stage_name": "LogStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.logic",
      "icon": "≡",
      "icon_mono": false,
      "color": null,
      "description": "Emit log event with message and the stage's own arguments",
      "arguments": [
        {
          "name": "message",
          "type": "string",
          "optional": true,
          "description": "Log message",
          "default": ""
        },
        {
          "name": "*",
          "type": "any",
          "optional": false,
          "description": "Anything else passed in arguments is logged as-is"
        }
      ],
      "outputs": []
    },
    "SleepStage": {
      "stage_name": "SleepStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.logic",
      "icon": "⏱",
      "icon_mono": false,
      "color": null,
      "description": "Async sleep for the given number of seconds",
      "arguments": [
        {
          "name": "seconds",
          "type": "number",
          "optional": true,
          "description": "Duration to sleep in seconds",
          "default": 0
        }
      ],
      "outputs": []
    },
    "ConcatStage": {
      "stage_name": "ConcatStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.strings",
      "icon": "⧺",
      "icon_mono": false,
      "color": null,
      "description": "Concatenate stringified parts with separator",
      "arguments": [
        {
          "name": "parts",
          "type": "list",
          "optional": false,
          "description": "Values to concatenate (non-strings are stringified)"
        },
        {
          "name": "separator",
          "type": "string",
          "optional": true,
          "description": "Separator between parts",
          "default": ""
        }
      ],
      "outputs": [
        {
          "name": "value",
          "type": "string",
          "optional": false,
          "description": "Concatenated string"
        }
      ]
    },
    "TemplateStage": {
      "stage_name": "TemplateStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.strings",
      "icon": "{}",
      "icon_mono": false,
      "color": null,
      "description": "Format template string with the stage's own arguments",
      "arguments": [
        {
          "name": "template",
          "type": "string",
          "optional": false,
          "description": "Template string; a placeholder is a bare argument name ({name})"
        },
        {
          "name": "*",
          "type": "any",
          "optional": false,
          "description": "Any other argument becomes a template placeholder value"
        }
      ],
      "outputs": [
        {
          "name": "value",
          "type": "string",
          "optional": false,
          "description": "Rendered string"
        }
      ]
    },
    "SetValueStage": {
      "stage_name": "SetValueStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.vars",
      "icon": "=",
      "icon_mono": false,
      "color": null,
      "description": "Set value from arguments to the target path",
      "arguments": [
        {
          "name": "value",
          "type": "any",
          "optional": false,
          "description": "Value to set (literal via const, or a variable reference)"
        }
      ],
      "outputs": [
        {
          "name": "value",
          "type": "any",
          "optional": false,
          "description": "Value that was written"
        }
      ]
    },
    "CopyValueStage": {
      "stage_name": "CopyValueStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.vars",
      "icon": "⧉",
      "icon_mono": false,
      "color": null,
      "description": "Copy value to output path, falling back to default when absent",
      "arguments": [
        {
          "name": "value",
          "type": "any",
          "optional": false,
          "description": "Value to copy"
        },
        {
          "name": "default",
          "type": "any",
          "optional": true,
          "description": "Used when 'value' is missing or null"
        }
      ],
      "outputs": [
        {
          "name": "value",
          "type": "any",
          "optional": false,
          "description": "Copied value"
        }
      ]
    },
    "IncrementStage": {
      "stage_name": "IncrementStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.vars",
      "icon": "＋",
      "icon_mono": false,
      "color": null,
      "description": "Increment numeric value by delta",
      "arguments": [
        {
          "name": "current",
          "type": "number",
          "optional": false,
          "description": "Current numeric value"
        },
        {
          "name": "delta",
          "type": "number",
          "optional": true,
          "description": "Increment step",
          "default": 1
        }
      ],
      "outputs": [
        {
          "name": "value",
          "type": "number",
          "optional": false,
          "description": "Result after increment"
        }
      ]
    },
    "MergeDictStage": {
      "stage_name": "MergeDictStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "builtin.vars",
      "icon": "⋈",
      "icon_mono": false,
      "color": null,
      "description": "Shallow merge src dict into dst",
      "arguments": [
        {
          "name": "src",
          "type": "object",
          "optional": false,
          "description": "Dict with overrides"
        },
        {
          "name": "dst",
          "type": "object",
          "optional": true,
          "description": "Base dict to merge into (empty by default)",
          "default": {}
        }
      ],
      "outputs": [
        {
          "name": "merged",
          "type": "object",
          "optional": false,
          "description": "Merged dict result"
        }
      ]
    },
    "LoadTicketStage": {
      "stage_name": "LoadTicketStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "support.data",
      "icon": "/icons/ticket.svg",
      "icon_mono": true,
      "color": null,
      "description": "Takes a prepared ticket out of data/tickets.json",
      "arguments": [
        {
          "name": "ticket_id",
          "type": "string",
          "optional": true,
          "description": "Ticket id (T-1001); empty — the first one in the file"
        }
      ],
      "outputs": [
        {
          "name": "ticket",
          "type": "dict",
          "optional": false,
          "description": "The whole ticket"
        },
        {
          "name": "text",
          "type": "string",
          "optional": false,
          "description": "The customer's message"
        },
        {
          "name": "subject",
          "type": "string",
          "optional": false,
          "description": "The subject line"
        },
        {
          "name": "customer_id",
          "type": "string",
          "optional": false,
          "description": "Who wrote it"
        }
      ]
    },
    "LoadCustomerStage": {
      "stage_name": "LoadCustomerStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "support.data",
      "icon": "/icons/user.svg",
      "icon_mono": true,
      "color": null,
      "description": "The customer's plan and how fast they are owed an answer",
      "arguments": [
        {
          "name": "customer_id",
          "type": "string",
          "optional": false,
          "description": "Customer id (C-77)"
        }
      ],
      "outputs": [
        {
          "name": "customer",
          "type": "dict",
          "optional": false,
          "description": "The whole customer record"
        },
        {
          "name": "name",
          "type": "string",
          "optional": false,
          "description": "Who to address in the reply"
        },
        {
          "name": "plan",
          "type": "string",
          "optional": false,
          "description": "free | pro | enterprise"
        },
        {
          "name": "reply_within_hours",
          "type": "int",
          "optional": false,
          "description": "The promised answer time for that plan"
        }
      ]
    },
    "ClassifyByRulesStage": {
      "stage_name": "ClassifyByRulesStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "support.triage",
      "icon": "/icons/tag.svg",
      "icon_mono": true,
      "color": null,
      "description": "Topic and urgency by keywords — no model, no network",
      "arguments": [
        {
          "name": "text",
          "type": "string",
          "optional": false,
          "description": "The customer's message"
        },
        {
          "name": "subject",
          "type": "string",
          "optional": true,
          "description": "The subject line — often the clearest words are there"
        }
      ],
      "outputs": [
        {
          "name": "topic",
          "type": "string",
          "optional": false,
          "description": "billing | technical | account | product | other"
        },
        {
          "name": "urgency",
          "type": "string",
          "optional": false,
          "description": "low | normal | high"
        },
        {
          "name": "matched",
          "type": "list",
          "optional": false,
          "description": "The words the decision was made on — so it can be argued with"
        }
      ]
    },
    "SearchKnowledgeStage": {
      "stage_name": "SearchKnowledgeStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "support.data",
      "icon": "/icons/book.svg",
      "icon_mono": true,
      "color": null,
      "description": "Looks for an article in the knowledge base by topic and words",
      "arguments": [
        {
          "name": "text",
          "type": "string",
          "optional": false,
          "description": "The customer's message"
        },
        {
          "name": "topic",
          "type": "string",
          "optional": true,
          "description": "Narrows the search down to one topic"
        }
      ],
      "outputs": [
        {
          "name": "found",
          "type": "bool",
          "optional": false,
          "description": "Whether anything matched — the graph branches on this"
        },
        {
          "name": "article",
          "type": "dict",
          "optional": false,
          "description": "The article, or the fallback one when nothing matched"
        },
        {
          "name": "answer",
          "type": "string",
          "optional": false,
          "description": "The article text, with {placeholders} still in it"
        },
        {
          "name": "article_id",
          "type": "string",
          "optional": false,
          "description": "Which article it was"
        }
      ]
    },
    "RenderReplyStage": {
      "stage_name": "RenderReplyStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "support.reply",
      "icon": "/icons/pen.svg",
      "icon_mono": true,
      "color": null,
      "description": "Fills the placeholders of an answer: {ticket_id}, {name}, …",
      "arguments": [
        {
          "name": "answer",
          "type": "string",
          "optional": false,
          "description": "The text with {placeholders}"
        },
        {
          "name": "*",
          "type": "any",
          "optional": true,
          "description": "Anything else becomes a placeholder value"
        }
      ],
      "outputs": [
        {
          "name": "reply",
          "type": "string",
          "optional": false,
          "description": "The finished reply"
        },
        {
          "name": "missing",
          "type": "list",
          "optional": false,
          "description": "Placeholders nothing was given for — they stay as they are"
        }
      ]
    },
    "SendReplyStage": {
      "stage_name": "SendReplyStage",
      "skipable": false,
      "allowed_events": [
        {
          "type": "reply_chunk",
          "description": "A piece of the reply as it is typed out",
          "payload_schema": {
            "stream": "bool",
            "text": "str",
            "label": "str"
          }
        },
        {
          "type": "reply_sent",
          "description": "The reply left for the customer",
          "payload_schema": {
            "ticket_id": "str",
            "channel": "str",
            "chars": "int"
          }
        }
      ],
      "allowed_inputs": [],
      "category": "support.reply",
      "icon": "/icons/send.svg",
      "icon_mono": true,
      "color": null,
      "description": "Sends the reply to the customer — and types it out as it goes",
      "arguments": [
        {
          "name": "reply",
          "type": "string",
          "optional": false,
          "description": "What to send"
        },
        {
          "name": "ticket_id",
          "type": "string",
          "optional": true,
          "description": "Which ticket it answers"
        },
        {
          "name": "channel",
          "type": "string",
          "optional": true,
          "description": "email | chat",
          "default": "email"
        }
      ],
      "outputs": [
        {
          "name": "sent",
          "type": "bool",
          "optional": false,
          "description": "Always true — a failure is an exception, not a flag"
        },
        {
          "name": "chars",
          "type": "int",
          "optional": false,
          "description": "How long the reply was"
        }
      ]
    },
    "EscalateStage": {
      "stage_name": "EscalateStage",
      "skipable": false,
      "allowed_events": [
        {
          "type": "escalated",
          "description": "The ticket went to a human",
          "payload_schema": {
            "ticket_id": "str",
            "queue": "str",
            "reason": "str"
          }
        }
      ],
      "allowed_inputs": [],
      "category": "support.reply",
      "icon": "/icons/escalate.svg",
      "icon_mono": true,
      "color": null,
      "description": "Hands the ticket to a human and says why",
      "arguments": [
        {
          "name": "ticket_id",
          "type": "string",
          "optional": false,
          "description": "Which ticket"
        },
        {
          "name": "reason",
          "type": "string",
          "optional": false,
          "description": "Why a person is needed"
        },
        {
          "name": "queue",
          "type": "string",
          "optional": true,
          "description": "Which queue it goes into",
          "default": "tier-2"
        }
      ],
      "outputs": [
        {
          "name": "task_id",
          "type": "string",
          "optional": false,
          "description": "The id of the task created for the human"
        },
        {
          "name": "queue",
          "type": "string",
          "optional": false,
          "description": "Where it landed"
        }
      ]
    },
    "LlmTriageStage": {
      "stage_name": "LlmTriageStage",
      "skipable": false,
      "allowed_events": [],
      "allowed_inputs": [],
      "category": "support.triage",
      "icon": "/icons/sparkles.svg",
      "icon_mono": true,
      "color": "#c084fc",
      "description": "Reads the ticket: topic, urgency, mood, one-line summary",
      "arguments": [
        {
          "name": "text",
          "type": "string",
          "optional": false,
          "description": "The customer's message"
        },
        {
          "name": "subject",
          "type": "string",
          "optional": true,
          "description": "The subject line, if there is one"
        },
        {
          "name": "model",
          "type": "string",
          "optional": true,
          "description": "Model identifier (every gateway has its own)"
        },
        {
          "name": "api_key",
          "type": "string",
          "optional": true,
          "description": "API key; empty — from the server environment"
        },
        {
          "name": "base_url",
          "type": "string",
          "optional": true,
          "description": "A custom API address (proxy, gateway, local stub)"
        }
      ],
      "outputs": [
        {
          "name": "topic",
          "type": "string",
          "optional": false,
          "description": "billing | technical | account | product | other"
        },
        {
          "name": "urgency",
          "type": "string",
          "optional": false,
          "description": "low | normal | high"
        },
        {
          "name": "mood",
          "type": "string",
          "optional": false,
          "description": "calm | annoyed | angry"
        },
        {
          "name": "summary",
          "type": "string",
          "optional": false,
          "description": "What the ticket is about, in one sentence"
        }
      ]
    },
    "LlmReplyStage": {
      "stage_name": "LlmReplyStage",
      "skipable": false,
      "allowed_events": [
        {
