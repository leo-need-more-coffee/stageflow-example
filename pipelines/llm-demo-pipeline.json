{
  "metadata": {
    "title": "Topic overview: a plan → parallel answers → a merge",
    "description": "Live OpenAI API calls. The key arrives as the OPENAI_API_KEY variable from the editor's secret store."
  },
  "types": {
    "Plan": {
      "questions": "list<string>",
      "difficulty": "string",
      "angle?": "string"
    },
    "Usage": {
      "input": "int",
      "output": "int"
    }
  },
  "variables": {
    "topic": "string",
    "plan": "Plan",
    "sources": "list<string>",
    "body_text": "string",
    "report": "string",
    "usage": "Usage"
  },
  "nodes": [
    {
      "id": "start",
      "type": "entry",
      "variables": {
        "topic": "stream data processing"
      },
      "next": "guard"
    },
    {
      "id": "guard",
      "type": "try",
      "body": "plan",
      "next": "work",
      "except": [
        {
          "error_equals": [
            "LlmAuthError"
          ],
          "next": "no_key",
          "result_var": "error"
        },
        {
          "error_equals": [
            "LlmRefused"
          ],
          "next": "refused",
          "result_var": "error"
        },
        {
          "error_equals": [
            "*"
          ],
          "next": "plan_fallback",
          "result_var": "error"
        }
      ]
    },
    {
      "id": "plan",
      "type": "stage",
      "stage": "LlmJsonStage",
      "arguments": {
        "vars": {
          "api_key": "OPENAI_API_KEY"
        },
        "const": {
          "prompt.$": "'Topic: ' + vars.topic + '\\n\\nBreak it down into three independent sub-questions whose answers together make a substantial overview. Judge whether the topic needs to be taken apart (hard) or can be answered in one paragraph (easy).'",
          "system": "You are an analyst. Write densely, with no filler and no openers like 'sure' — straight to the point.",
          "schema": {
            "type": "object",
            "properties": {
              "questions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Exactly three independent sub-questions that open the topic up"
              },
              "difficulty": {
                "type": "string",
                "enum": [
                  "easy",
                  "hard"
                ],
                "description": "hard — the topic needs to be taken apart"
              },
              "angle": {
                "type": "string",
                "description": "Which side to approach the topic from"
              }
            },
            "required": [
              "questions",
              "difficulty",
              "angle"
            ],
            "additionalProperties": false
          }
        }
      },
      "outputs": {
        "data": "plan",
        "input_tokens": "plan_in",
        "output_tokens": "plan_out"
      },
      "retry": [
        {
          "error_equals": [
            "LlmRateLimited",
            "LlmOverloaded"
          ],
          "max_attempts": 3,
          "interval_seconds": 2,
          "backoff_rate": 2
        }
      ]
    },
    {
      "id": "no_key",
      "type": "stage",
      "stage": "LogStage",
      "arguments": {
        "vars": [
          "error"
        ],
        "const": {
          "message": "no OpenAI API key — there is no point going further"
        }
      },
      "next": "halt"
    },
    {
      "id": "halt",
      "type": "terminal",
      "result": {
        "status": "no_key"
      }
    },
    {
      "id": "refused",
      "type": "stage",
      "stage": "LogStage",
      "arguments": {
        "vars": [
          "error"
        ],
        "const": {
          "message": "the model rejected the request, falling back to the spare plan"
        }
      },
      "next": "plan_fallback"
    },
    {
      "id": "plan_fallback",
      "type": "stage",
      "stage": "SetValueStage",
      "arguments": {
        "const": {
          "value": {
            "questions": [
              "What is it?",
              "Where is it used?",
              "What are its limits?"
            ],
            "difficulty": "easy",
            "angle": "an overview without a plan: the planner did not answer"
          }
        }
      },
      "outputs": {
        "value": "plan"
      },
      "next": "work"
    },
    {
      "id": "work",
      "type": "try",
      "body": "route",
      "next": "polish",
      "except": [
        {
          "error_equals": [
            "LlmAuthError"
          ],
          "next": "no_key",
          "result_var": "error"
        },
        {
          "error_equals": [
            "*"
          ],
          "next": "degrade",
          "result_var": "error"
        }
      ]
    },
    {
      "id": "route",
      "type": "switch",
      "cases": [
        {
          "when": "vars.plan.difficulty == 'hard'",
          "next": "deep"
        }
      ],
      "default": "quick_prep"
    },
    {
      "id": "deep",
      "type": "parallel",
      "branches": [
        {
          "id": "q1",
          "entry": "a1"
        },
        {
          "id": "q2",
          "entry": "a2"
        },
        {
          "id": "q3",
          "entry": "a3"
        },
        {
          "id": "src",
          "entry": "src_guard"
        }
      ],
      "next": "merge"
    },
    {
      "id": "a1",
      "type": "stage",
      "stage": "LlmMessageStage",
      "arguments": {
        "vars": {
          "api_key": "OPENAI_API_KEY"
        },
        "const": {
          "prompt.$": "vars.plan.questions[0]",
          "system": "You are an analyst. Write densely, with no filler and no openers like 'sure' — straight to the point. The answer is one paragraph, no longer than six sentences.",
          "max_tokens": 1200
        }
      },
      "outputs": {
        "text": "ans1",
        "input_tokens": "in1",
        "output_tokens": "out1"
      },
      "retry": [
        {
          "error_equals": [
            "LlmRateLimited",
            "LlmOverloaded"
          ],
          "max_attempts": 3,
          "interval_seconds": 2
        }
      ]
    },
    {
      "id": "a2",
      "type": "stage",
      "stage": "LlmMessageStage",
      "arguments": {
        "vars": {
          "api_key": "OPENAI_API_KEY"
        },
        "const": {
          "prompt.$": "vars.plan.questions[1]",
          "system": "You are an analyst. Write densely, with no filler and no openers like 'sure' — straight to the point. The answer is one paragraph, no longer than six sentences.",
          "max_tokens": 1200
        }
      },
      "outputs": {
        "text": "ans2",
        "input_tokens": "in2",
        "output_tokens": "out2"
      },
      "retry": [
        {
          "error_equals": [
            "LlmRateLimited",
            "LlmOverloaded"
          ],
          "max_attempts": 3,
          "interval_seconds": 2
        }
      ]
    },
    {
      "id": "a3",
      "type": "stage",
      "stage": "LlmMessageStage",
      "arguments": {
        "vars": {
          "api_key": "OPENAI_API_KEY"
        },
        "const": {
          "prompt.$": "vars.plan.questions[2]",
          "system": "You are an analyst. Write densely, with no filler and no openers like 'sure' — straight to the point. The answer is one paragraph, no longer than six sentences.",
          "max_tokens": 1200
        }
      },
      "outputs": {
        "text": "ans3",
        "input_tokens": "in3",
        "output_tokens": "out3"
      },
      "retry": [
        {
          "error_equals": [
            "LlmRateLimited",
            "LlmOverloaded"
          ],
          "max_attempts": 3,
          "interval_seconds": 2
        }
      ]
    },
    {
      "id": "src_guard",
      "type": "try",
      "body": "gh",
      "except": [
        {
          "error_equals": [
            "*"
          ],
          "next": "src_none",
          "result_var": "src_error"
        }
      ]
    },
    {
      "id": "gh",
      "type": "stage",
      "stage": "HttpGetStage",
      "arguments": {
        "const": {
          "url.$": "'https://api.github.com/search/repositories?per_page=5&sort=stars&q=' + vars.topic",
          "timeout": 10
        }
      },
      "outputs": {
        "json": "gh_raw",
        "status": "gh_status"
      },
      "retry": [
        {
          "error_equals": [
            "HttpTimeout",
            "HttpUnavailable",
            "HttpStatusError"
          ],
          "max_attempts": 2,
          "interval_seconds": 1
        }
      ],
      "next": "gh_pick"
    },
    {
      "id": "gh_pick",
      "type": "stage",
      "stage": "SetValueStage",
      "arguments": {
        "const": {
          "value.$": "vars.gh_raw.items.map(i, i.full_name)"
        }
      },
      "outputs": {
        "value": "sources"
      }
    },
    {
      "id": "src_none",
      "type": "stage",
      "stage": "SetValueStage",
      "arguments": {
        "const": {
          "value": []
        }
      },
      "outputs": {
        "value": "sources"
      }
    },
    {
      "id": "merge",
      "type": "stage",
      "stage": "ConcatStage",
      "arguments": {
        "const": {
          "parts.$": "[vars.ans1, vars.ans2, vars.ans3]",
          "separator": "\n\n"
        }
      },
      "outputs": {
        "value": "body_text"
      },
      "next": "tally_deep"
    },
    {
      "id": "tally_deep",
      "type": "stage",
      "stage": "SetValueStage",
      "arguments": {
        "const": {
          "value.$": "{'input': vars.in1 + vars.in2 + vars.in3 + (has(vars.plan_in) ? vars.plan_in : 0), 'output': vars.out1 + vars.out2 + vars.out3 + (has(vars.plan_out) ? vars.plan_out : 0)}"
        }
      },
      "outputs": {
        "value": "usage"
      }
    },
    {
      "id": "quick_prep",
      "type": "stage",
      "stage": "SetValueStage",
      "arguments": {
        "const": {
          "value": []
        }
      },
      "outputs": {
        "value": "sources"
      },
      "next": "quick"
    },
    {
      "id": "quick",
      "type": "stage",
      "stage": "LlmMessageStage",
      "arguments": {
        "vars": {
          "api_key": "OPENAI_API_KEY"
        },
        "const": {
          "prompt.$": "'Explain briefly: ' + vars.topic",
          "system": "You are an analyst. Write densely, with no filler and no openers like 'sure' — straight to the point.",
          "max_tokens": 1200
        }
      },
      "outputs": {
        "text": "body_text",
        "input_tokens": "q_in",
        "output_tokens": "q_out"
      },
      "retry": [
        {
          "error_equals": [
            "LlmRateLimited",
            "LlmOverloaded"
          ],
          "max_attempts": 3
        }
      ],
      "next": "tally_quick"
    },
    {
      "id": "tally_quick",
      "type": "stage",
      "stage": "SetValueStage",
      "arguments": {
        "const": {
          "value.$": "{'input': vars.q_in + (has(vars.plan_in) ? vars.plan_in : 0), 'output': vars.q_out + (has(vars.plan_out) ? vars.plan_out : 0)}"
        }
      },
      "outputs": {
        "value": "usage"
      }
    },
    {
      "id": "polish",
      "type": "subpipeline",
      "subpipeline_id": "report",
      "inputs": {
        "source": "body_text",
        "topic": "topic",
        "api_key": "OPENAI_API_KEY"
      },
      "artifact_outputs": {
        "report": "report"
      },
      "next": "done"
    },
    {
      "id": "done",
      "type": "terminal",
      "result": {
        "status": "ok"
      },
      "artifacts": [
        "report",
        "plan",
        "usage",
        "sources",
        "body_text"
      ]
    },
    {
      "id": "degrade",
      "type": "stage",
      "stage": "LogStage",
      "arguments": {
        "vars": [
          "error"
        ],
        "const": {
          "message": "the answers did not come together — returning what there is"
        }
      },
      "next": "partial"
    },
    {
      "id": "partial",
      "type": "terminal",
      "result": {
        "status": "partial"
      },
      "artifacts": [
        "plan"
      ]
    }
  ],
  "subpipelines": {
    "report": {
      "nodes": [
        {
          "id": "r_start",
          "type": "entry",
          "next": "r_prompt"
        },
        {
          "id": "r_prompt",
          "type": "stage",
          "stage": "TemplateStage",
          "arguments": {
            "vars": {
              "topic": "topic",
              "source": "source"
            },
            "const": {
              "template": "Topic: {topic}\n\nDraft answers:\n{source}\n\nMake a coherent overview of 3-5 paragraphs out of them: no repetitions, with explicit conclusions at the end. Do not refer to these being drafts."
            }
          },
          "outputs": {
            "value": "prompt"
          },
          "next": "r_write"
        },
        {
          "id": "r_write",
          "type": "stage",
          "stage": "LlmMessageStage",
          "arguments": {
            "vars": {
              "prompt": "prompt",
              "api_key": "api_key"
            },
            "const": {
              "system": "You are an editor: you merge drafts into coherent text and cut the filler.",
              "max_tokens": 2000
            }
          },
          "outputs": {
            "text": "report"
          },
          "retry": [
            {
              "error_equals": [
                "LlmRateLimited",
                "LlmOverloaded"
              ],
              "max_attempts": 3
            }
          ],
          "next": "r_done"
        },
        {
          "id": "r_done",
          "type": "terminal",
          "artifacts": [
            "report"
          ]
        }
      ]
    }
  }
}