{
  "nodes": [
    {
      "id": "start",
      "type": "entry",
      "variables": {
        "n": 5
      },
      "next": "check"
    },
    {
      "id": "check",
      "type": "condition",
      "condition": "vars.n > 3",
      "then": "fan_out",
      "else": "small"
    },
    {
      "id": "fan_out",
      "type": "parallel",
      "branches": [
        {
          "id": "inc",
          "entry": "inc"
        },
        {
          "id": "label",
          "entry": "label"
        },
        {
          "id": "api",
          "entry": "guard"
        }
      ],
      "next": "report"
    },
    {
      "id": "guard",
      "type": "try",
      "body": "fetch",
      "next": "settle",
      "except": [
        {
          "error_equals": [
            "TimeoutError",
            "ConnectionError"
          ],
          "next": "on_network_fail",
          "result_var": "error"
        },
        {
          "error_equals": [
            "*"
          ],
          "next": "on_unexpected",
          "result_var": "error"
        }
      ]
    },
    {
      "id": "fetch",
      "type": "stage",
      "stage": "HttpRequestStage",
      "arguments": {
        "const": {
          "url": "https://example.com/api"
        }
      },
      "outputs": {
        "body": "payload"
      },
      "retry": [
        {
          "error_equals": [
            "TimeoutError"
          ],
          "max_attempts": 3
        }
      ],
      "next": "parse"
    },
    {
      "id": "parse",
      "type": "stage",
      "stage": "PickKeysStage",
      "arguments": {
        "vars": {
          "src": "payload"
        },
        "const": {
          "keys": [
            "items"
          ]
        }
      },
      "outputs": {
        "result": "parsed"
      }
    },
    {
      "id": "on_network_fail",
      "type": "stage",
      "stage": "LogStage",
      "arguments": {
        "vars": [
          "error"
        ],
        "const": {
          "message": "the network is down, returning an empty result"
        }
      },
      "next": "fallback"
    },
    {
      "id": "on_unexpected",
      "type": "stage",
      "stage": "LogStage",
      "arguments": {
        "vars": [
          "error"
        ],
        "const": {
          "message": "an unexpected error in the block"
        }
      },
      "next": "fallback"
    },
    {
      "id": "fallback",
      "type": "stage",
      "stage": "SetValueStage",
      "arguments": {
        "const": {
          "value": {}
        }
      },
      "outputs": {
        "value": "parsed"
      },
      "next": "settle"
    },
    {
      "id": "settle",
      "type": "stage",
      "stage": "LogStage",
      "arguments": {
        "vars": [
          "parsed"
        ],
        "const": {
          "message": "the api branch is done"
        }
      }
    },
    {
      "id": "inc",
      "type": "stage",
      "stage": "IncrementStage",
      "arguments": {
        "vars": {
          "current": "n"
        },
        "const": {
          "delta": 10
        }
      },
      "outputs": {
        "value": "total"
      }
    },
    {
      "id": "label",
      "type": "stage",
      "stage": "ConcatStage",
      "arguments": {
        "const": {
          "parts.$": "['count:', string(vars.n)]",
          "separator": " "
        }
      },
      "outputs": {
        "value": "caption"
      }
    },
    {
      "id": "report",
      "type": "stage",
      "stage": "LlmCompleteStage",
      "arguments": {
        "vars": {
          "prompt": "caption"
        }
      },
      "outputs": {
        "completion": "summary"
      },
      "next": "done"
    },
    {
      "id": "done",
      "type": "terminal",
      "result": {
        "status": "big"
      },
      "artifacts": [
        "total",
        "caption",
        "summary",
        "parsed"
      ]
    },
    {
      "id": "small",
      "type": "terminal",
      "result": {
        "status": "small"
      }
    }
  ]
}
